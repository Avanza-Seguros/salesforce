<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Sin_cotizaciones</name>
        <label>Sin cotizaciones</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>No existe cortizacion en la Oportunidad, necesita agregar por lo menos una para cambiar el estatus {!No_Existe_Quote}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Verifica_Existencia_Poliza</name>
        <label>Verifica Existencia Poliza</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Existe_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Quote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sin_cotizaciones</targetReference>
            </connector>
            <label>No Existe Quote</label>
        </rules>
        <rules>
            <name>No_existe_poliza</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Existing_Policy</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Primary_Quote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Insured_Policy</targetReference>
            </connector>
            <label>No existe poliza</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FechaPago</name>
        <dataType>Date</dataType>
        <expression>IF(
  ISPICKVAL({!Get_Primary_Quote.Frecuencia_de_prima__c}, &quot;Mensual&quot;), 
  {!$Flow.CurrentDate} + 30,
  IF(
    ISPICKVAL({!Get_Primary_Quote.Frecuencia_de_prima__c}, &quot;Bimestral&quot;), 
    {!$Flow.CurrentDate} + 60,
    IF(
      ISPICKVAL({!Get_Primary_Quote.Frecuencia_de_prima__c}, &quot;Trimestral&quot;), 
      {!$Flow.CurrentDate} + 90,
      IF(
        ISPICKVAL({!Get_Primary_Quote.Frecuencia_de_prima__c}, &quot;Semestral&quot;), 
        {!$Flow.CurrentDate} + 180,
        IF(
          ISPICKVAL({!Get_Primary_Quote.Frecuencia_de_prima__c}, &quot;Anual&quot;), 
          {!$Flow.CurrentDate} + 365,
          {!$Flow.CurrentDate}
        )
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>FechaVencimiento</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <interviewLabel>Create Insured Policy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Insured Policy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Insured_Policy</name>
        <label>Create Insured Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Aseguradora__c</field>
            <value>
                <elementReference>Get_Primary_Quote.Aseguradora__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EffectiveDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpirationDate</field>
            <value>
                <elementReference>FechaVencimiento</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>GrossWrittenPremium</field>
            <value>
                <elementReference>Get_Primary_Quote.TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Get_Primary_Quote.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NameInsuredId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PaymentDueDate</field>
            <value>
                <elementReference>FechaPago</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PolicyName</field>
            <value>
                <stringValue>POL-{!$Record.Name}{!$System.OriginDateTime}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PolicyTerm</field>
            <value>
                <elementReference>Get_Primary_Quote.Frecuencia_de_prima__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PolicyType</field>
            <value>
                <elementReference>Get_Primary_Quote.Ramos__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PremiumAmount</field>
            <value>
                <elementReference>Get_Primary_Quote.TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PremiumFrequency</field>
            <value>
                <elementReference>Get_Primary_Quote.Frecuencia_de_prima__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProductId</field>
            <value>
                <elementReference>Get_Primary_Quote.Product__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceOpportunityId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceQuoteId</field>
            <value>
                <elementReference>Get_Primary_Quote.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Inicial</stringValue>
            </value>
        </inputAssignments>
        <object>InsurancePolicy</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Check_Existing_Policy</name>
        <label>Check Existing Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verifica_Existencia_Poliza</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SourceOpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>SourceQuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Primary_Quote.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>InsurancePolicy</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Primary_Quote</name>
        <label>Get Primary Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Quote_Line_Items</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Quote_Coverages</name>
        <label>Get Quote Coverages</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Existing_Policy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Primary_Quote.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote_Coverage__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Quote_Line_Items</name>
        <label>Get Quote Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Quote_Coverages</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Primary_Quote.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Primary_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Póliza</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
