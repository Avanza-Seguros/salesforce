    </constants>
    <constants>
        <name>horaInicio</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>9.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Si_la_hora_esta_dentro_del_horario_permitido</name>
        <label>Si la hora esta dentro del horario permitido</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>asignarmsgSalida</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FueraHorarioAtencion</defaultConnectorLabel>
        <rules>
            <name>Verificar_Hora_Actual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HoraActual</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>horaInicio</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>HoraActual</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>horaFin</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>diaEnLaSemana</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Sunday</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>diaEnLaSemana</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Saturday</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copia_1_de_asignarmsgSalida</targetReference>
            </connector>
            <label>Verificar Hora Actual</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>diaEnLaSemana</name>
        <dataType>String</dataType>
        <expression>CASE(
  MOD( TODAY() - DATE( 1900, 1, 7 ), 7 ),
  0, &quot;Sunday&quot;,
  1, &quot;Monday&quot;,
  2, &quot;Tuesday&quot;,
  3, &quot;Wednesday&quot;,
  4, &quot;Thursday&quot;,
  5, &quot;Friday&quot;, 
  &quot;Saturday&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HoraActual</name>
        <dataType>Number</dataType>
        <expression>VALUE( MID( TEXT( NOW()- (6/24)), 12 ,2) )</expression>
        <scale>0</scale>
    </formulas>
