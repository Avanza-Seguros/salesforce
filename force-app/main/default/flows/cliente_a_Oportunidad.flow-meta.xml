    <formulas>
        <name>ApellidoMaterno</name>
        <dataType>String</dataType>
        <expression>RIGHT(
  {!$Record.Account.Name},
  LEN({!$Record.Account.Name}) - FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}) + 1) + 1)
)</expression>
    </formulas>
    <formulas>
        <name>Apellidopaterno</name>
        <dataType>String</dataType>
        <expression>MID(
  {!$Record.Account.Name},
  FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}) + 1) + 1,
  FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}) + 1) + 1) - FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}) + 1) - 1
)</expression>
    </formulas>
    <formulas>
        <name>nombre</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}, FIND(&quot; &quot;, {!$Record.Account.Name}) + 1) - 1)</expression>
    </formulas>
