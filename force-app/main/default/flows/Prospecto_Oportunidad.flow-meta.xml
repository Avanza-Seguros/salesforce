        <dataType>String</dataType>
        <expression>TRIM({!$Record.Prospecto__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Prospecto__r.MiddleName})</expression>
    </formulas>
    <interviewLabel>Prospecto-Oportunidad {!$Flow.CurrentDateTime}</interviewLabel>
