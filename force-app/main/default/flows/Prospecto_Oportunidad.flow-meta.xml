        </inputAssignments>
        <inputAssignments>
            <field>Correo__c</field>
            <value>
                <elementReference>$Record.Prospecto__r.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Horno_mes__c</field>
            <value>
                <elementReference>$Record.Prospecto__r.Horno_mes__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Referido_por_cliente__c</field>
