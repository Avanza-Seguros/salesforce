                <elementReference>$Record.Prospecto__r.Referido_por_cliente__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Referido_por_contacto__c</field>
            <value>
                <elementReference>$Record.Prospecto__r.Referido_por_contacto__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Referido_por_oportunidad__c</field>
            <value>
