                <leftValueReference>$Record__Prior.Estatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vigor sin Pago de Primas</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Estatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vigor Prorrogado</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Fecha_de_Cancelacion</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
