<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <description>Calcula si el campo Fecha de cancelacion del registro de HDI tiene una diferencia de 30 dias entonces va a retornar True para ejecutar el cambio, caso contrario lo deja igual.</description>
        <name>CalculoFechaCancelacionHdi</name>
        <dataType>Date</dataType>
        <expression>IF(ADDMONTHS({!$Record.Fecha_de_Cancelacion__c}, 1) &lt;= TODAY(), {!$Record.Fecha_de_Cancelacion__c}, ADDMONTHS({!$Record.Fecha_de_Cancelacion__c}, 2))</expression>
    </formulas>
    <formulas>
        <name>Hoy</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Cancelacion HDI {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cancelacion HDI</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Actualizar_registros_1</name>
        <label>Actualizar registros 1</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fecha_de_Cancelacion__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CalculoFechaCancelacionHdi</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Cancelacion__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Estatus_pago__c</field>
            <value>
                <stringValue>Cancelado</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Actualizar_registros_1</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Aseguradora__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>HDI</stringValue>
            </value>
        </filters>
        <filters>
            <field>Estatus_del_Pago__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelado</stringValue>
            </value>
        </filters>
        <object>Pago_poliza__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
