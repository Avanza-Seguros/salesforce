<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>isLatePayment__c</fullName>
    <description>Indica si el pago fue reconocido de forma tardía.</description>
    <formula>AND(NOT(ISBLANK(daysPastDueAtRecognition__c)), daysPastDueAtRecognition__c &gt; 0)</formula>
    <label>Es pago tardío</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
