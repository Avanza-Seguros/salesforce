<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Business_Account</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &apos;Business_Account&apos;,
    OR(
        ISBLANK(AnnualRevenue),
        AnnualRevenue &lt;= 0
    )
)</errorConditionFormula>
    <errorMessage>Annual Revenue es obligatorio para cuentas empresariales.</errorMessage>
</ValidationRule>
