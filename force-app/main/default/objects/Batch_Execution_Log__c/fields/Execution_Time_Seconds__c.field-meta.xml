<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Execution_Time_Seconds__c</fullName>
    <description>Tiempo total de ejecución en segundos</description>
    <externalId>false</externalId>
    <formula>ROUND((End_Time__c - Start_Time__c) * 24 * 60 * 60, 2)</formula>
    <label>Tiempo Ejecución (seg)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
