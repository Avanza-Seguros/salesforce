<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Informacion_Adicional</fullName>
    <active>true</active>
    <description>Se debe llenar informacion adicional</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Etapa__c, &apos;Información Adicional&apos;),
    ISBLANK(Informacion_Adicional__c)
)</errorConditionFormula>
    <errorMessage>Se debe llenar informacion adicional</errorMessage>
</ValidationRule>
