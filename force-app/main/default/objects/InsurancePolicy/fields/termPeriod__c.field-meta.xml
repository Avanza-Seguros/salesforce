<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>termPeriod__c</fullName>
    <description
	>Inicio y fin de la vigencia (dd/mm/aaaa). Distingue en la búsqueda y en las listas las vigencias de una póliza que comparten número.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(EffectiveDate), &quot;&quot;,
LPAD(TEXT(DAY(DATEVALUE(EffectiveDate))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(DATEVALUE(EffectiveDate))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(DATEVALUE(EffectiveDate))) &amp;
IF(ISBLANK(ExpirationDate), &quot;&quot;,
&quot; - &quot; &amp;
LPAD(TEXT(DAY(DATEVALUE(ExpirationDate))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(DATEVALUE(ExpirationDate))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(DATEVALUE(ExpirationDate)))))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Vigencia</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
