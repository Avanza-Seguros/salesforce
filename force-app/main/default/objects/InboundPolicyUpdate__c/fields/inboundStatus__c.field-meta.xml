                <label>Recibido</label>
            </value>
            <value>
                <fullName>Aplicado</fullName>
                <default>false</default>
                <label>Aplicado</label>
            </value>
            <value>
                <fullName>Revision Manual</fullName>
                <default>false</default>
                <label>Revisión Manual</label>
            </value>
            <value>
                <fullName>Rechazado</fullName>
                <default>false</default>
                <label>Rechazado</label>
            </value>
            <value>
                <fullName>Superada</fullName>
                <default>false</default>
                <label>Superada</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
