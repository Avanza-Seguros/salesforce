<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Asegurado_De_La_Poliza</fullName>
    <active>true</active>
    <description>El asegurado del participante debe pertenecer a la póliza del siniestro.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(InsurancePolicyParticipantId)),
    InsurancePolicyParticipant.InsurancePolicyId &lt;&gt; Claim.PolicyNumberId
)</errorConditionFormula>
    <errorDisplayField>InsurancePolicyParticipantId</errorDisplayField>
    <errorMessage>El asegurado no pertenece a la póliza del siniestro.</errorMessage>
</ValidationRule>
