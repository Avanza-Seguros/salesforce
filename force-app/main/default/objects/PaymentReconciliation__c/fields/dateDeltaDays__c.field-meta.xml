<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>dateDeltaDays__c</fullName>
    <description>Diferencia en días entre la fecha de pago de origen y el vencimiento de la cuota.</description>
    <externalId>false</externalId>
    <formula>IF(OR(ISBLANK(inboundPayment__c), ISBLANK(paymentPlanInstallment__c), ISBLANK(inboundPayment__r.sourcePaymentDate__c), ISBLANK(paymentPlanInstallment__r.dueDate__c)), NULL, ABS(inboundPayment__r.sourcePaymentDate__c - paymentPlanInstallment__r.dueDate__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Diferencia de días</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
