<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Falta_Cliente</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
   ISBLANK(AccountId),
   ISPICKVAL(StageName, &quot;Cerrada Ganada&quot;)
)</errorConditionFormula>
