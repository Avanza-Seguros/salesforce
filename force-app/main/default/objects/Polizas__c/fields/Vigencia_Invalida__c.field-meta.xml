<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Vigencia_Invalida__c</fullName>
    <formula>AND(
  NOT(ISBLANK(Vigencia_desde__c)),
  NOT(ISBLANK(Vigencia_hasta__c)),
  Vigencia_desde__c &gt;= Vigencia_hasta__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Vigencia Invalida</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
