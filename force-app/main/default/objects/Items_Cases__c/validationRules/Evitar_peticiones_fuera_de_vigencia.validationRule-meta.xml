<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Evitar_peticiones_fuera_de_vigencia</fullName>
    <active>false</active>
    <errorConditionFormula>OR(
				Fecha_de_peticion__c &lt; Poliza__r.Vigencia_desde__c,
				Fecha_de_peticion__c &gt;  Poliza__r.Vigencia_hasta__c 
)</errorConditionFormula>
    <errorMessage>No es posible generar peticiones para pólizas fuera del periodo de vigencia</errorMessage>
</ValidationRule>
