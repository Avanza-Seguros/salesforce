<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Edicion_de_estatus</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISPICKVAL( Estatus__c , &quot;En proceso&quot;),ISPICKVAL(Estatus__c , &quot;Concluido&quot;),ISPICKVAL(Estatus__c , &quot;Rechazado&quot;)),
$User.Username != &quot;abraham.gonzalez@avanzaseguro.com&quot;, 

$User.Username != &quot;esmeralda.lopez@avanzaseguro.com&quot;, 

$User.Username != &quot;tramites@avanzaseguro.com&quot;, 

$User.Username != &quot;adminavanza@volestra.com&quot;,

$User.Username != &quot;cotizaciones@avanzaseguro.com&quot;, $User.Username != &quot;gmm@avanzaseguro.com&quot;)</errorConditionFormula>
    <errorDisplayField>Estatus__c</errorDisplayField>
    <errorMessage>Solo el personal de Avanza puede modificar el estatus de la petición</errorMessage>
</ValidationRule>
