<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Homephone</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(HomePhone)),
NOT(
REGEX(
HomePhone,
&quot;^(\\+52)?[0-9]{10}$&quot;
)
)
)</errorConditionFormula>
    <errorDisplayField>HomePhone</errorDisplayField>
    <errorMessage>Formato de teléfono no permitido</errorMessage>
</ValidationRule>
