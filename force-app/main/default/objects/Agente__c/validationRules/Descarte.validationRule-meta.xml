<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Descarte</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Descartado&quot;),
    ISPICKVAL(Horno_mes__c, &quot;&quot;),
    ISBLANK(Motivo_De_Descarte__c)
)</errorConditionFormula>
    <errorMessage>Se deben Llenar los campos de Horno Del Mes y Motivo De Descarte</errorMessage>
</ValidationRule>
