<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Telefono_Formato_Mexico</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(Phone)) &amp;&amp;
   NOT(REGEX(Phone, &quot;^(\\+52)?[0-9]{10}$&quot;))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>El teléfono debe tener 10 dígitos sin letras ni espacios (ej. 5512345678).</errorMessage>
</ValidationRule>
