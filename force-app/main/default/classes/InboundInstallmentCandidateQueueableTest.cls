	@IsTest
	static void leavesNullWhenPolicyHasSeveralOpenPlans() {
		// Al dejar de exigir plan Activo, una poliza puede presentar cuotas abiertas de dos
		// planes distintos. Puntuarlas juntas mezclaria dos calendarios y podria aplicar el
		// cobro al plan equivocado, asi que no se elige ninguna.
		Id accountId = CollectionsTestDataFactory.getDefaultInsuredAccountId();
		InsurancePolicy policy = new InsurancePolicy(
			Name = 'POL-IC-011',
			PolicyName = 'Test Policy',
			NameInsuredId = accountId,
			Status = 'Inicial',
			PremiumAmount = 1000,
			PremiumFrequency = 'Mensual',
			PaymentDueDate = Date.today()
		);
		insert policy;
		deleteAutoGeneratedPlans(policy.Id);

		Date dueDate = Date.today().addDays(30);
		PaymentPlan__c activePlan = createActivePlan(policy.Id);
		PaymentPlan__c cancelledPlan = new PaymentPlan__c(
			insurancePolicy__c = policy.Id,
			planStatus__c = 'Cancelado',
			premiumFrequency__c = 'Mensual',
			expectedTotalAmount__c = 1200,
			firstDueDate__c = Date.today()
		);
		insert cancelledPlan;
		createInstallment(activePlan.Id, 1, dueDate, 400, 'Pendiente');
		createInstallment(cancelledPlan.Id, 1, dueDate, 400, 'Pendiente');

		InboundInsurancePayment__c inbound = createNormalizedInbound(
			'EXT-IC-011',
			policy.Id,
			null,
			dueDate,
			400
		);

		Test.startTest();
		System.enqueueJob(
			new InboundInstallmentCandidateQueueable(new Set<Id>{ inbound.Id })
		);
		Test.stopTest();

		inbound = [
			SELECT candidateInstallment__c, installmentMatchReason__c
			FROM InboundInsurancePayment__c
			WHERE Id = :inbound.Id
		];
		Assert.isNull(
			inbound.candidateInstallment__c,
			'Con dos planes abiertos no se adivina cual es el correcto.'
		);
		Assert.areEqual('PLANES_MULTIPLES', inbound.installmentMatchReason__c);
	}

	// ================================================================ KAN-425
	// El cobro programado se vincula a su cuota desde que la aseguradora lo emite.

	/**
	 * Un recibo emitido y aun no cobrado: sin fecha de pago y en 'Pendiente de Pago'.
	 */
	private static InboundInsurancePayment__c createScheduledCharge(
		String externalId,
		Id policyId,
		Date dueDate,
		Decimal amount
	) {
		InboundInsurancePayment__c rec = new InboundInsurancePayment__c(
			externalPaymentId__c = externalId,
			inboundStatus__c = 'Pendiente de Pago',
			carrierReceiptStatus__c = 'Pendiente',
			candidatePolicy__c = policyId,
			sourceAmount__c = amount,
			sourceDueDate__c = dueDate,
			sourceReceiptNumber__c = 'REC-' + externalId,
			sourcePolicyNumber__c = 'POL-PROG',
			sourceSystem__c = 'MuleSoft',
			receivedAt__c = System.now(),
			parsedAt__c = System.now()
		);
		insert rec;
		return rec;
	}

	private static InsurancePolicy createPolicyWithSingleInstallment(
		String name,
		Date dueDate,
		Decimal amount
	) {
		InsurancePolicy policy = new InsurancePolicy(
			Name = name,
			PolicyName = 'Test Policy',
			NameInsuredId = CollectionsTestDataFactory.getDefaultInsuredAccountId(),
			Status = 'Inicial',
			PremiumAmount = 1000,
			PremiumFrequency = 'Mensual',
			PaymentDueDate = Date.today()
		);
		insert policy;
		deleteAutoGeneratedPlans(policy.Id);
		PaymentPlan__c plan = createActivePlan(policy.Id);
		createInstallment(plan.Id, 1, dueDate, amount, 'Pendiente');
		return policy;
	}

	@IsTest
	static void scheduledChargeFindsItsInstallment() {
		Date dueDate = Date.today().addDays(30);
		InsurancePolicy policy = createPolicyWithSingleInstallment(
			'POL-PROG-001',
			dueDate,
			400
		);
		InboundInsurancePayment__c inbound = createScheduledCharge(
			'EXT-PROG-001',
			policy.Id,
			dueDate,
			400
		);

		Test.startTest();
		System.enqueueJob(
			new InboundInstallmentCandidateQueueable(new Set<Id>{ inbound.Id })
		);
		Test.stopTest();

		inbound = [
			SELECT
				candidateInstallment__c,
				inboundStatus__c,
				installmentMatchReason__c
			FROM InboundInsurancePayment__c
			WHERE Id = :inbound.Id
		];
		Assert.isNotNull(
			inbound.candidateInstallment__c,
			'El cobro programado tiene que saber a que cuota va.'
		);
		Assert.areEqual('UNICO_GANADOR', inbound.installmentMatchReason__c);
		Assert.areEqual(
			'Pendiente de Pago',
			inbound.inboundStatus__c,
			'Identificar la cuota no lo mete al pipeline: sigue esperando el cobro.'
		);
	}

	@IsTest
	static void scheduledChargeDoesNothingElse() {
		// El criterio central de la historia: se vincula y NADA MAS. Si esto se rompe, el
		// sistema estaria dando por cobrado algo que la aseguradora aun no ha cobrado.
		Date dueDate = Date.today().addDays(30);
		InsurancePolicy policy = createPolicyWithSingleInstallment(
			'POL-PROG-002',
			dueDate,
			400
		);
		InboundInsurancePayment__c inbound = createScheduledCharge(
			'EXT-PROG-002',
			policy.Id,
			dueDate,
			400
		);

		Test.startTest();
		System.enqueueJob(
			new InboundInstallmentCandidateQueueable(new Set<Id>{ inbound.Id })
		);
		Test.stopTest();

		Assert.areEqual(
			0,
			[SELECT COUNT() FROM PolicyPaymentReceipt__c],
			'Un cobro que aun no ocurrio no puede generar comprobante.'
		);
		Assert.areEqual(
			0,
			[SELECT COUNT() FROM PaymentReconciliation__c],
			'Ni conciliacion.'
		);

		PaymentPlanInstallment__c installment = [
			SELECT installmentStatus__c, matchedReceipt__c, matchedOn__c
			FROM PaymentPlanInstallment__c
			WHERE paymentPlan__r.insurancePolicy__c = :policy.Id
			LIMIT 1
		];
		Assert.areEqual(
			'Pendiente',
			installment.installmentStatus__c,
			'La cuota sigue abierta: la obligacion no ha desaparecido.'
		);
		Assert.isNull(
			installment.matchedReceipt__c,
			'Escribir el recibo vinculado bloquearia la cuota para el cobro real.'
		);
		Assert.isNull(installment.matchedOn__c);
	}

	@IsTest
	static void scheduledChargeWithoutInstallmentIsNotAnIncident() {
		// Sin cuota identificable no va a la bandeja de revision: todavia no hay dinero de por
		// medio. Queda listado aparte, porque suele significar que a nuestro plan le falta algo.
		InsurancePolicy policy = new InsurancePolicy(
			Name = 'POL-PROG-003',
			PolicyName = 'Test Policy',
			NameInsuredId = CollectionsTestDataFactory.getDefaultInsuredAccountId(),
			Status = 'Inicial',
			PremiumAmount = 1000,
			PremiumFrequency = 'Mensual',
			PaymentDueDate = Date.today()
		);
		insert policy;
		deleteAutoGeneratedPlans(policy.Id);

		InboundInsurancePayment__c inbound = createScheduledCharge(
			'EXT-PROG-003',
			policy.Id,
			Date.today().addDays(30),
			400
		);

		Test.startTest();
		System.enqueueJob(
			new InboundInstallmentCandidateQueueable(new Set<Id>{ inbound.Id })
		);
		Test.stopTest();

		inbound = [
			SELECT
				candidateInstallment__c,
				inboundStatus__c,
				manualReviewRequired__c,
				installmentMatchReason__c
			FROM InboundInsurancePayment__c
			WHERE Id = :inbound.Id
		];
		Assert.isNull(inbound.candidateInstallment__c);
		Assert.areEqual('SIN_CUOTAS', inbound.installmentMatchReason__c);
		Assert.areEqual(
			'Pendiente de Pago',
			inbound.inboundStatus__c,
			'No cambia de estado: sigue siendo un cobro que no ha ocurrido.'
		);
		Assert.isFalse(
			inbound.manualReviewRequired__c,
			'No es un caso para el analista: no hay ningun cobro que decidir.'
		);
	}

	@IsTest
	static void scheduledChargeExposesTheAmountMismatch() {
		// El valor real de la historia: la aseguradora emitio 450 y nuestra cuota dice 400.
		// Hoy eso se descubre el dia del cobro; aqui se ve al emitirse el recibo.
		Date dueDate = Date.today().addDays(30);
		InsurancePolicy policy = createPolicyWithSingleInstallment(
			'POL-PROG-004',
			dueDate,
			400
		);
		InboundInsurancePayment__c inbound = createScheduledCharge(
			'EXT-PROG-004',
			policy.Id,
			dueDate,
			420
		);

		Test.startTest();
		System.enqueueJob(
			new InboundInstallmentCandidateQueueable(new Set<Id>{ inbound.Id })
		);
		Test.stopTest();

		inbound = [
			SELECT candidateInstallment__c, scheduledChargeMismatch__c
			FROM InboundInsurancePayment__c
			WHERE Id = :inbound.Id
		];
		Assert.isNotNull(
			inbound.candidateInstallment__c,
			'420 contra 400 esta dentro de la tolerancia del match, asi que si engancha.'
		);
		Assert.areEqual(
			'Importe',
			inbound.scheduledChargeMismatch__c,
			'Y la diferencia queda a la vista sin tocar la cuota.'
		);
	}

